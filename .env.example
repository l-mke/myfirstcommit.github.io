# Bybit credentials
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Environment and live toggle
BYBIT_TESTNET=true
BYBIT_LIVE_TRADING=false
BYBIT_CATEGORY=linear
BYBIT_SETTLE_COIN=USDT
BYBIT_ORDER_TYPE=Market

# Optional private WS
BYBIT_PRIVATE_WS_ENABLED=false
BYBIT_PRIVATE_WS_URL=wss://stream-testnet.bybit.com/v5/private

# Leverage management
BYBIT_LEVERAGE=3
BYBIT_SET_LEVERAGE_ON_START=false

# Runtime
BOT_EQUITY_USDT=10000
BOT_KLINE_INTERVAL=1
BOT_KLINE_LIMIT=200
BOT_ORDERBOOK_LIMIT=50
BOT_EVENT_STORE_PATH=events/bot_events.jsonl

# Monitoring and simulation
BOT_MAX_AVG_SLIPPAGE_BPS=8
BOT_MAX_AVG_FILL_DELAY_MS=1500
BOT_SIMULATE_FILLS=true
BOT_PARTIAL_FILL_PROB=0.3
BOT_REJECT_PROB=0.02
BOT_TP_PARTIAL_CLOSE_RATIO=0.5
BOT_TRAILING_DISTANCE_PCT=0.003
SENTRY_DSN=
OTEL_ENABLED=false
